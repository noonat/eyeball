{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}/.claude\"; f=\"$d/voice.local.md\"; [ -f \"$f\" ] || f=\"$d/voice.md\"; [ -f \"$f\" ] && jq -Rs '{hookSpecificOutput:{hookEventName:\"UserPromptSubmit\",additionalContext:.}}' < \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/commit-gate.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
